# ── Server ──
PORT=4000
NODE_ENV=development

# ── Database (MongoDB) ──
MONGODB_URI=mongodb://localhost:27017/insurance_crm

# ── Auth ──
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
MAX_SESSIONS_PER_USER=3

# ── Bootstrap admin (created by `npm run seed`) ──
BOOTSTRAP_ADMIN_EMAIL=admin@insurancecrm.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# ── CORS (comma separated) ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
